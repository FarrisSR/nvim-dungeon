[Unit]
Description=NvimDungeon Score API
After=network.target

[Service]
Type=simple
User=runo
WorkingDirectory=/home/runo/code/nvim-dungeon/server
ExecStart=/home/runo/code/nvim-dungeon/server/venv/bin/uvicorn main:app --host 127.0.0.1 --port 3002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
